
# ==================================================
# SRE AGENT - ENVIRONMENT CONFIGURATION
# ==================================================

# --------------------------------------------------
# Application
# --------------------------------------------------
APP_NAME=SRE Agent
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------
POSTGRES_DB=sre_agent
POSTGRES_USER=sre_agent
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

DATABASE_URL=postgresql+asyncpg://sre_agent:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@localhost:5432/sre_agent

# --------------------------------------------------
# Redis
# --------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --------------------------------------------------
# Authentication
# --------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------------
# Encryption
# --------------------------------------------------
ENCRYPTION_KEY=CHANGE_ME_TO_A_VALID_ENCRYPTION_KEY

# --------------------------------------------------
# LLM Provider
# --------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=4096

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# --------------------------------------------------
# Infrastructure Connectors
# --------------------------------------------------

# Prometheus
PROMETHEUS_URL=
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=

# Grafana
GRAFANA_URL=
GRAFANA_API_TOKEN=

# Kubernetes
KUBERNETES_CONTEXT=
KUBERNETES_NAMESPACE=default

# AWS
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --------------------------------------------------
# Observability
# --------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sre-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

PROMETHEUS_METRICS_ENABLED=true

# --------------------------------------------------
# API Security
# --------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# --------------------------------------------------
# Background Workers
# --------------------------------------------------
WORKER_CONCURRENCY=2
TASK_SOFT_TIME_LIMIT=300
TASK_HARD_TIME_LIMIT=360

# --------------------------------------------------
# Billing
# --------------------------------------------------
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------
# Development
# --------------------------------------------------
TESTING=false
